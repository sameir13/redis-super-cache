{
  "name": "tagcache",
  "version": "2.0.0",
  "description": "Production Redis caching with fflate compression, tag invalidation, stampede protection, pipelines, warmup, and Prometheus metrics",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:clean": "rimraf dist && npm run build",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration": "jest --runInBand --config jest.integration.config.js",
    "prepublishOnly": "npm run build:clean && npm run test"
  },
  "keywords": [
    "redis",
    "cache",
    "tagcache",
    "compression",
    "tags",
    "invalidation",
    "nestjs",
    "prometheus",
    "stampede-protection",
    "warmup"
  ],
  "author": "sameir13",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sameir13/tagcache.git"
  },
  "bugs": {
    "url": "https://github.com/sameir13/tagcache/issues"
  },
  "homepage": "https://github.com/sameir13/tagcache#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "prom-client": "^15.1.0",
    "redis": "^4.6.0",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/xxhashjs": "^0.2.4",
    "jest": "^29.5.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0"
  }
}
